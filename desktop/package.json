{
  "name": "@subs/desktop",
  "version": "0.8.7",
  "private": true,
  "description": "Subtitles desktop app for macOS: live Cantonese→Mandarin subtitles, overlay window, recording",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:helpers": "node scripts/build-helpers.js",
    "dist": "npm run build:helpers && electron-builder --mac",
    "release": "sh scripts/release.sh",
    "verify:release": "node scripts/verify-release.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@subs/core": "*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.0.0"
  },
  "productName": "See Subtitles"
}

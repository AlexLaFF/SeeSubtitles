{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See Subtitles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "See Subtitles"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See Subtitles uses the camera to scan the code of a talk you want to join."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "See Subtitles 使用相机扫描你想加入的讲座的二维码。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See Subtitles listens to the microphone while a talk is running, to turn speech into subtitles and keep the recording on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "See Subtitles 仅在进行中时使用麦克风，把语音变成字幕，并将录音保存在本机。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
